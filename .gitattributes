# Normaliza detecção de arquivos de texto.
* text=auto

# Scripts rodam em Linux (CI/servidores) e DEVEM ter EOL LF mesmo em checkout no Windows — senão o
# shebang vira "#!/usr/bin/env bash\r" e quebra. vssh-app-publish não tem extensão, então precisa
# ser listado explicitamente.
*.sh                      text eol=lf
scripts/vssh-app-publish   text eol=lf
scripts/vssh-app-lib-sync  text eol=lf

# Binários — sem conversão
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.svg   binary
# A fonte do ambiente, em lib/web/tuff/fonts/. O `text=auto` acima provavelmente acertaria sozinho
# (detecta binario por byte nulo), e "provavelmente" nao e resposta para um arquivo de 30 KB cuja
# corrupcao apareceria como texto invisivel na tela de um app, e nao como erro.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
