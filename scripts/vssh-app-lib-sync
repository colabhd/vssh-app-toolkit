#!/usr/bin/env bash
# vssh-app-lib-sync — copia as bibliotecas do toolkit para dentro do repo de um vssh-app.
# Uso: vssh-app-lib-sync <dir-do-app> [--parts fs,spa,log,sse,web] [--ref main] [--dest vendor/vssh]
#
# DOIS DESTINOS, e a distinção importa:
#
#   vssh-app-lib-sync . --parts fs,spa,log,sse --dest backend/vendor/vssh
#   vssh-app-lib-sync . --parts web            --dest frontend/vendor/vssh
#
# As libs de `node/` são `require()`adas pelo backend, então ficam ao lado dele. As de `web/` são
# carregadas pelo NAVEGADOR por uma tag <script> — precisam estar sob a raiz que o `static-spa`
# serve (`frontend/`), senão a tag injetada por `injectScripts` aponta para 404. Esse era o defeito
# do template até a Onda 0: a tag era injetada e ninguém servia o arquivo.
#
# Por que copiar em vez de instalar: `vssh-app-publish` empacota o que está VERSIONADO, então o
# que não estiver commitado não chega ao servidor. É o mesmo caminho que a SKILL prega para
# node_modules — vendorizar e commitar. O resultado entra no tarball e o app fica auto-suficiente.
#
# Para as libs de `web/` há ainda uma razão estrutural, e essa não depende de política nenhuma:
# elas são carregadas pelo NAVEGADOR e precisam ficar sob a raiz que o `static-spa` serve.
#
# NÃO é porque o servidor-alvo não alcança registry npm — ele alcança. Essa justificativa esteve
# escrita aqui, no README e na SKILL, entrou num único commit de desenho e nunca foi medida.
#
# O custo desta escolha é conhecido e ainda não está pago: a cópia envelhece EM SILÊNCIO. O
# `.vssh-lib-version` abaixo registra procedência e data, e hoje nenhum programa lê esse arquivo —
# nem o publish, nem o install, nem o shim, que sequer sabe a própria versão. Ver
# docs/roadmap/03-toolkit.md.
#
# Depois de rodar, revise o diff e commite. O arquivo `.vssh-lib-version` registra de onde veio,
# para você saber o que precisa ressincronizar quando o toolkit andar.
#
# Partes:
#   fs   → lib/node/vssh-app-fs/    filesystem privado do app (HTTP), confinado e token-gated
#   spa  → lib/node/static-spa.js   serve uma SPA construída sob o prefixo do proxy
#   log  → lib/node/app-log.js      log estruturado em $VSSH_APP_DATA_DIR
#   sse  → lib/node/sse.js          Server-Sent Events que sobrevivem ao proxy e ao CDN
#   tray → lib/node/vssh-tray.js    ícone na bandeja para app SEM janela (engine/service)
#   notify → lib/node/vssh-notify.js  avisar o usuário a partir do backend, sem janela aberta
#   web  → lib/web/                 shim do frontend, polyfill da FSA, shims Tauri/Electron
#   all  → tudo (default)
set -euo pipefail

# `main` e não `v1`: a tag `v1` é do toolkit original, anterior à criação de `lib/` — fora de um
# clone, `--ref v1` falha com "lib/ não encontrado no tarball". Ver docs/roadmap/03-toolkit.md.
APP_DIR="" PARTS="all" REF="main" DEST="vendor/vssh"
REPO="colabhd/vssh-app-toolkit"

while [ $# -gt 0 ]; do
  case "$1" in
    --parts) PARTS="$2"; shift 2 ;;
    --ref)   REF="$2";   shift 2 ;;
    --dest)  DEST="$2";  shift 2 ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) [ -z "${APP_DIR}" ] && APP_DIR="$1" || { echo "Argumento inesperado: $1" >&2; exit 1; }; shift ;;
  esac
done

[ -n "${APP_DIR}" ] || { echo "ERRO: informe o diretório do app." >&2; exit 1; }
[ -d "${APP_DIR}" ] || { echo "ERRO: '${APP_DIR}' não é diretório." >&2; exit 1; }

# ── 1. Onde está o lib/ do toolkit ────────────────────────────────────────────
# Rodando de um clone, está ao lado deste script. Rodando do sparse checkout do CI (que traz só
# `scripts/`), não está — aí baixamos o tarball do ref pedido.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
CLEANUP=""
trap '[ -n "${CLEANUP}" ] && rm -rf "${CLEANUP}"' EXIT

if [ -d "${HERE}/lib" ]; then
  LIB_SRC="${HERE}/lib"
  ORIGIN="local:$(git -C "${HERE}" rev-parse --short HEAD 2>/dev/null || echo 'sem-git')"
else
  TMP="$(mktemp -d)"; CLEANUP="${TMP}"
  echo "lib/ não está ao lado do script; baixando ${REPO}@${REF}..." >&2
  curl -fsSL "https://codeload.github.com/${REPO}/tar.gz/${REF}" | tar -xz -C "${TMP}"
  LIB_SRC="$(find "${TMP}" -maxdepth 2 -type d -name lib | head -1)"
  [ -n "${LIB_SRC}" ] || { echo "ERRO: lib/ não encontrado no tarball de ${REF}." >&2; exit 1; }
  ORIGIN="${REPO}@${REF}"
fi

# ── 2. Copia as partes pedidas ────────────────────────────────────────────────
TARGET="${APP_DIR%/}/${DEST}"
mkdir -p "${TARGET}"

want() { case ",${PARTS}," in *,all,*) return 0 ;; *",$1,"*) return 0 ;; *) return 1 ;; esac; }

copied=""
if want fs;  then mkdir -p "${TARGET}/node" && cp -R "${LIB_SRC}/node/vssh-app-fs" "${TARGET}/node/" && copied="${copied} vssh-app-fs"; fi
if want spa; then mkdir -p "${TARGET}/node" && cp "${LIB_SRC}/node/static-spa.js" "${TARGET}/node/" && copied="${copied} static-spa.js"; fi
if want log; then mkdir -p "${TARGET}/node" && cp "${LIB_SRC}/node/app-log.js"    "${TARGET}/node/" && copied="${copied} app-log.js"; fi
if want sse; then mkdir -p "${TARGET}/node" && cp "${LIB_SRC}/node/sse.js"        "${TARGET}/node/" && copied="${copied} sse.js"; fi
if want tray;then mkdir -p "${TARGET}/node" && cp "${LIB_SRC}/node/vssh-tray.js"  "${TARGET}/node/" && copied="${copied} vssh-tray.js"; fi
if want notify; then mkdir -p "${TARGET}/node" && cp "${LIB_SRC}/node/vssh-notify.js" "${TARGET}/node/" && copied="${copied} vssh-notify.js"; fi
if want web; then mkdir -p "${TARGET}/web"  && cp -R "${LIB_SRC}/web/." "${TARGET}/web/" \
  && rm -rf "${TARGET}/web/test" && copied="${copied} web/"; fi

[ -n "${copied}" ] || { echo "ERRO: nenhuma parte selecionada (--parts '${PARTS}')." >&2; exit 1; }

# Os testes das libs de `node/` vão junto: são o que prova que a cópia vendorizada continua
# íntegra, e rodam sem env var nenhuma do VSSH (`node --test vendor/vssh/node/vssh-app-fs/test/`).
#
# Os de `web/` NÃO vão, e a assimetria tem duas razões independentes:
#
#   1. o destino de `web/` fica sob a raiz que o `static-spa` serve — é onde ele PRECISA ficar
#      para a tag injetada não dar 404. Levar os testes junto os publica como asset do app;
#   2. desde a Onda 3 uma parte deles roda num navegador de verdade e depende do runner em
#      `tests/browser/`, que não é uma lib e não é vendorizado. A cópia não teria como executar —
#      e um teste que não pode rodar contradiz exatamente o motivo pelo qual os outros vão.

# ── 3. Marca a procedência ────────────────────────────────────────────────────
cat > "${TARGET}/.vssh-lib-version" <<EOF
origin=${ORIGIN}
parts=${PARTS}
synced_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF

echo "✅ Sincronizado em ${TARGET}:${copied}"
echo "   Revise o diff e commite — é o que faz o tarball do app ser auto-suficiente."
